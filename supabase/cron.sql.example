-- Schedule Edge Functions with pg_cron + pg_net AFTER deploying functions and storing secrets in Vault.
-- select vault.create_secret('<project-url>', 'project_url'); select vault.create_secret('<CRON_SECRET>', 'cron_secret');
select cron.schedule('monitor-p0', '*/15 * * * *', $$ select net.http_post(url := (select decrypted_secret from vault.decrypted_secrets where name='project_url') || '/functions/v1/monitor-prices', headers := jsonb_build_object('x-cron-secret', (select decrypted_secret from vault.decrypted_secrets where name='cron_secret')), body := '{"priority":"P0"}'::jsonb) $$);
select cron.schedule('monitor-p1', '0 * * * *',    $$ select net.http_post(url := (select decrypted_secret from vault.decrypted_secrets where name='project_url') || '/functions/v1/monitor-prices', headers := jsonb_build_object('x-cron-secret', (select decrypted_secret from vault.decrypted_secrets where name='cron_secret')), body := '{"priority":"P1"}'::jsonb) $$);
select cron.schedule('monitor-p2', '0 */3 * * *',  $$ select net.http_post(url := (select decrypted_secret from vault.decrypted_secrets where name='project_url') || '/functions/v1/monitor-prices', headers := jsonb_build_object('x-cron-secret', (select decrypted_secret from vault.decrypted_secrets where name='cron_secret')), body := '{"priority":"P2"}'::jsonb) $$);
select cron.schedule('monitor-p3', '0 */12 * * *', $$ select net.http_post(url := (select decrypted_secret from vault.decrypted_secrets where name='project_url') || '/functions/v1/monitor-prices', headers := jsonb_build_object('x-cron-secret', (select decrypted_secret from vault.decrypted_secrets where name='cron_secret')), body := '{"priority":"P3"}'::jsonb) $$);
select cron.schedule('send-notifications', '* * * * *', $$ select net.http_post(url := (select decrypted_secret from vault.decrypted_secrets where name='project_url') || '/functions/v1/send-notifications', headers := jsonb_build_object('x-cron-secret', (select decrypted_secret from vault.decrypted_secrets where name='cron_secret')), body := '{}'::jsonb) $$);
select cron.schedule('evaluate-outcomes', '*/30 * * * *', $$ select net.http_post(url := (select decrypted_secret from vault.decrypted_secrets where name='project_url') || '/functions/v1/evaluate-outcomes', headers := jsonb_build_object('x-cron-secret', (select decrypted_secret from vault.decrypted_secrets where name='cron_secret')), body := '{}'::jsonb) $$);
