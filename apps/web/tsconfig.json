{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve", "allowJs": true, "incremental": true, "plugins": [{ "name": "next" }],
    "lib": ["dom", "dom.iterable", "ES2022"], "types": ["node"], "paths": { "@/*": ["./src/*"] }
